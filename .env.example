APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://fraud:fraud@postgres:5432/fraud
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
MODEL_PATH=/app/artifacts/models/champion.joblib
MLFLOW_TRACKING_URI=http://mlflow:5000
FRAUD_REVIEW_THRESHOLD=0.40
FRAUD_BLOCK_THRESHOLD=0.70
USE_MODEL_THRESHOLDS=true
REVIEW_COST=5.00
FALSE_POSITIVE_COST=25.00
REVIEW_CATCH_RATE=0.80
MAX_REVIEW_RATE=0.05
SIMULATOR_RATE_PER_SECOND=2
SIMULATOR_SEED=42
EXPLANATION_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
