{
  "title": "Fraud Platform Operations",
  "uid": "fraud-platform",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"type":"timeseries","title":"Transaction decisions","id":1,"gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum by (decision) (rate(fraud_transactions_total[1m]))","legendFormat":"{{decision}}"}]},
    {"type":"timeseries","title":"P95 inference latency","id":2,"gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(fraud_inference_latency_seconds_bucket[5m])))","legendFormat":"p95"}]},
    {"type":"timeseries","title":"Errors","id":3,"gridPos":{"h":8,"w":24,"x":0,"y":8},"targets":[{"expr":"sum by (component,error_type) (rate(fraud_errors_total[5m]))","legendFormat":"{{component}} {{error_type}}"}]}
  ]
}

